// مجموعة فرجا (Farja Group) — مخطط قاعدة البيانات
// PostgreSQL + Prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── التعدادات ───────────────────────────

enum UserRole {
  ADMIN // Super Admin: كل الصلاحيات
  STAFF // موظف إدارة (صلاحيات كاملة كما في الإصدارات السابقة)
  MANAGER // Delivery Manager: الطلبات والتوزيع والمتابعة والتحصيل
  DRIVER // Delivery Admin (موظف توصيل): الطلبات المسندة إليه فقط
}

/// حالة موحّدة للحجوزات والطلبات وطلبات الشركات
enum RequestStatus {
  NEW // جديد
  UNDER_REVIEW // قيد المراجعة
  PRICED // تم التسعير
  CONFIRMED // مؤكد
  IN_PROGRESS // قيد التنفيذ
  COMPLETED // مكتمل
  CANCELLED // ملغي
}

enum BookingType {
  INSPECTION // أعطال بناء / كشف عن الموقع
  PAINTING // أعمال دهان
  CONSTRUCTION // أعمال البناء
  METALWORK // أعمال معدنية
  GENERAL // خدمات عامة
}

enum Urgency {
  NORMAL // عادي
  URGENT // عاجل
  EMERGENCY // طارئ
}

enum AreaZone {
  INSIDE_AMMAN
  OUTSIDE_AMMAN
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum CorporateRequestType {
  ANNUAL // عقد صيانة سنوي
  URGENT // طلب صيانة عاجل
}

enum ProductionImpact {
  NO_STOP_NEEDED // يمكن العمل دون إيقاف الإنتاج
  CANNOT_STOP // لا يمكن إيقاف الإنتاج
  PARTIAL_STOP // يمكن الإيقاف جزئيًا
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

/// نوع العقد: صيانة عامة أو عقد سنوي لشركة
enum ContractType {
  MAINTENANCE
  ANNUAL_CORPORATE
}

enum RenewalStatus {
  NONE
  PENDING
  RENEWED
  NOT_RENEWING
}

enum ContractVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum TenderStatus {
  DRAFT
  OPEN
  CLOSED
  UNDER_REVIEW
  AWARDED
  CANCELLED
}

enum TenderOfferStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// حالة التوصيل (منفصلة عن حالة الطلب الموحّدة)
/// مسار الطلب: NEW → ACCEPTED → PICKUP_ASSIGNED → PICKED_UP → IN_TRANSIT → ARRIVED → DELIVERED → PAYMENT_COLLECTED → COMPLETED
enum DeliveryStatus {
  NEW
  ACCEPTED
  PICKUP_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  PAYMENT_COLLECTED
  COMPLETED
  // حالات استثنائية
  DELIVERY_FAILED
  CUSTOMER_NOT_AVAILABLE
  CUSTOMER_REFUSED
  WRONG_ADDRESS
  RESCHEDULED
  CANCELLED
}

/// الحالة المالية للطلب (تُحسب من طريقة الدفع والمبلغ المطلوب والمحصّل)
enum FinancialStatus {
  PAID
  COD
  PARTIAL_PAYMENT
  PAYMENT_PENDING
  COLLECTED
  NOT_COLLECTED
}

/// مصدر الطلب
enum OrderSource {
  STORE // من المتجر (سلة العميل)
  SUPPLIER // أنشأه المورد
  ADMIN // أنشأته الإدارة
}

enum AssignmentStatus {
  ASSIGNED // بانتظار قبول الموظف
  ACCEPTED
  UNASSIGNED // أُعيد إسناده أو أُلغي الإسناد
}

enum NotificationRecipient {
  USER // موظفو الإدارة والتوصيل
  CUSTOMER
  VENDOR
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

/// تحصيل الدفع عند الاستلام
enum CodStatus {
  PENDING
  COLLECTED
  SETTLED
}

enum SettlementStatus {
  CONFIRMED
  VOIDED
}

enum QuoteFileKind {
  EVALUATION // تقييم
  QUOTE // عرض سعر
  CONTRACT // عقد
  INVOICE // فاتورة
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CLIQ
  CARD
  OTHER
  COD
}

/// مراجعة منتجات الموردين قبل ظهورها في المتجر
enum ProductApproval {
  PENDING // بانتظار المراجعة
  APPROVED // معتمد
  REJECTED // مرفوض
}

enum WhatsAppChannel {
  LINK // رابط wa.me يفتحه المستخدم
  CLOUD_API // إرسال تلقائي عبر Meta Cloud API
}

enum WhatsAppStatus {
  PREPARED
  SENT
  FAILED
}

// ─────────────────────────── المستخدمون ───────────────────────────

/// حسابات لوحة التحكم (الأدمن والموظفون)
model User {
  id           String    @id @default(cuid())
  name         String
  /// اختياري لموظفي التوصيل (يدخلون باسم المستخدم)
  email        String?   @unique
  /// اسم المستخدم للدخول (أحرف إنجليزية صغيرة وأرقام) — يُخزَّن بأحرف صغيرة
  username     String?   @unique
  phone        String?
  passwordHash String
  role         UserRole  @default(ADMIN)
  /// الصلاحيات الفعلية للمستخدم (تبدأ من صلاحيات الدور ويعدّلها الـ Super Admin)
  permissions  String[]  @default([])
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// حذف ناعم: يبقى في السجلات ولا يدخل
  deletedAt    DateTime?

  auditLogs   AuditLog[]
  campaigns   EmailCampaign[]
  payments    Payment[]            @relation("PaymentRecordedBy")
  payouts     VendorPayout[]       @relation("PayoutRecordedBy")
  settlements DeliverySettlement[] @relation("SettlementReceivedBy")
  quotes      QuoteFile[]          @relation("QuoteUploadedBy")

  driver          Driver?
  statusEvents    OrderStatusEvent[]
  assignmentsMade DeliveryAssignment[] @relation("AssignedBy")
  proofs          DeliveryProof[]      @relation("ProofBy")
  collectedOrders Order[]              @relation("CollectedBy")
  notifications   Notification[]

  @@index([role])
}

/// العملاء — يتم إنشاؤهم تلقائيًا عند أول حجز أو طلب برقم الهاتف، أو بالتسجيل من صفحة /register
model Customer {
  id           String    @id @default(cuid())
  phone        String    @unique
  name         String
  /// يُخزن بأحرف صغيرة — يُستخدم للدخول مع كلمة المرور
  email        String?   @unique
  companyName  String?
  passwordHash String?
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  notes        String?
  lastLoginAt  DateTime?
  /// وقت إنشاء الحساب بالتسجيل الذاتي (فارغ للعملاء المنشئين تلقائيًا من الحجز)
  registeredAt DateTime?
  /// موافقة على استلام النشرة البريدية (منتجات وخدمات جديدة) — يمكن إلغاؤها من الحساب أو رابط البريد
  emailOptIn   Boolean   @default(true)
  /// تأكيد ملكية البريد برمز OTP
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  bookings          Booking[]
  orders            Order[]
  tenders           Tender[]
  vendor            Vendor?
  corporateRequests CorporateRequest[]
  contracts         Contract[]
  quoteFiles        QuoteFile[]
  payments          Payment[]

  @@index([name])
  @@index([deletedAt])
}

/// الفنيون الذين يُعيَّنون على الحجوزات
model Technician {
  id        String          @id @default(cuid())
  name      String
  phone     String
  specialty String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  bookings  Booking[]
  contracts Contract[]
  visits    ContractVisit[]
}

// ─────────────────────────── المتجر ───────────────────────────

/// أقسام السوق (ديناميكية من لوحة التحكم) — مستويان: قسم رئيسي وأقسام فرعية
model Category {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  /// القسم الرئيسي (فارغ للأقسام الرئيسية)
  parentId   String?
  /// حقول المواصفات لمنتجات هذا القسم: [{ key, label, type: text|number|select, options?, required? }]
  specFields Json      @default("[]")
  sortOrder  Int       @default(0)
  visible    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

/// المورد (متجر داخل السوق). المورد الافتراضي (isHouse) هو الشركة نفسها وليس له حساب عميل
model Vendor {
  id                String   @id @default(cuid())
  /// حساب العميل صاحب المتجر (فارغ للمورد الافتراضي)
  customerId        String?  @unique
  name              String
  slug              String   @unique
  description       String   @default("")
  logoUrl           String?
  logoPublicId      String?
  /// نسبة عمولة المنصة من كل بيع (0–100)
  commissionPercent Decimal  @default(10) @db.Decimal(5, 2)
  /// سحب صلاحية المورد: لا يدخل اللوحة ولا تظهر منتجاته
  active            Boolean  @default(true)
  isHouse           Boolean  @default(false)
  /// عنوان الاستلام الافتراضي لطلبات التوصيل
  phone             String?
  pickupAddress     String?
  pickupLat         Float?
  pickupLng         Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer     Customer?      @relation(fields: [customerId], references: [id])
  products     Product[]
  vendorOrders VendorOrder[]
  orderItems   OrderItem[]
  payouts      VendorPayout[]
  tenderOffers TenderOffer[]
  orders       Order[]        @relation("OrderSupplier")

  @@index([active])
}

model Product {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String
  /// السعر الأصلي بالدينار (3 خانات عشرية = فلس)
  price           Decimal         @db.Decimal(10, 3)
  /// نسبة الخصم 0–90
  discountPercent Int             @default(0)
  /// السعر النهائي بعد الخصم — يُحسب تلقائيًا عند الحفظ
  finalPrice      Decimal         @db.Decimal(10, 3)
  stock           Int             @default(0)
  visible         Boolean         @default(true)
  featured        Boolean         @default(false)
  categoryId      String
  vendorId        String
  /// منتجات الموردين تظهر بعد موافقة الإدارة
  approvalStatus  ProductApproval @default(PENDING)
  rejectionReason String?
  /// المواصفات حسب حقول القسم، مثل { "size": "L", "color": "أسود" }
  specs           Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  category   Category       @relation(fields: [categoryId], references: [id])
  vendor     Vendor         @relation(fields: [vendorId], references: [id])
  media      ProductMedia[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([vendorId])
  @@index([approvalStatus])
  @@index([visible, deletedAt])
  @@index([featured])
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  kind      MediaKind @default(IMAGE)
  url       String
  publicId  String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                String           @id @default(cuid())
  /// رقم الطلب المعروض (#1042)
  number            Int              @unique @default(autoincrement())
  /// رمز مرجعي عشوائي يستخدمه العميل للدخول لحسابه
  ref               String           @unique
  /// رقم الطلب الموحّد FG-ORD-000001
  code              String?          @unique
  source            OrderSource      @default(STORE)
  /// المورد صاحب طلب التوصيل (طلبات المورد/الإدارة)؛ طلبات المتجر مرتبطة بالموردين عبر الطلبات الفرعية
  supplierId        String?
  customerId        String
  customerName      String
  phone             String
  /// عنوان التسليم
  address           String
  deliveryLat       Float?
  deliveryLng       Float?
  /// منطقة التوصيل (للتصفية والتوزيع)
  area              String?
  pickupAddress     String?
  pickupLat         Float?
  pickupLng         Float?
  pickupPhone       String?
  notes             String?
  status            RequestStatus    @default(NEW)
  subtotal          Decimal          @db.Decimal(10, 3)
  discountTotal     Decimal          @db.Decimal(10, 3)
  total             Decimal          @db.Decimal(10, 3)
  whatsappText      String
  /// طريقة الدفع التي اختارها العميل (فارغة للطلبات القديمة)
  paymentMethod     PaymentMethod?
  // ── التوصيل ──
  deliveryStatus    DeliveryStatus   @default(NEW)
  driverId          String?
  deliveryCompanyId String?
  deliveryFee       Decimal          @default(0) @db.Decimal(10, 3)
  deliveredAt       DateTime?
  deliveryNote      String?
  acceptedAt        DateTime?
  pickedUpAt        DateTime?
  arrivedAt         DateTime?
  completedAt       DateTime?
  /// العميل يدفع أجرة التوصيل (تُضاف للمبلغ المطلوب تحصيله)
  customerPaysFee   Boolean          @default(true)
  financialStatus   FinancialStatus?
  // ── التحصيل ── codAmount = المبلغ المطلوب تحصيله من العميل (المنتجات حسب طريقة الدفع + أجرة التوصيل)
  codAmount         Decimal?         @db.Decimal(10, 3)
  codStatus         CodStatus?
  codCollected      Decimal?         @db.Decimal(10, 3)
  codCollectedAt    DateTime?
  collectedById     String?
  collectedMethod   PaymentMethod?
  /// رمز التحقق عند التسليم (OTP) — مشفّر
  otpHash           String?
  otpExpiresAt      DateTime?
  otpAttempts       Int              @default(0)
  settlementId      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  customer        Customer             @relation(fields: [customerId], references: [id])
  driver          Driver?              @relation(fields: [driverId], references: [id])
  deliveryCompany DeliveryCompany?     @relation(fields: [deliveryCompanyId], references: [id])
  settlement      DeliverySettlement?  @relation(fields: [settlementId], references: [id])
  supplier        Vendor?              @relation("OrderSupplier", fields: [supplierId], references: [id])
  collectedBy     User?                @relation("CollectedBy", fields: [collectedById], references: [id])
  statusEvents    OrderStatusEvent[]
  assignments     DeliveryAssignment[]
  proof           DeliveryProof?
  notifications   Notification[]
  items           OrderItem[]
  vendorOrders    VendorOrder[]
  payments        Payment[]
  quoteFiles      QuoteFile[]

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([deliveryStatus])
  @@index([driverId])
  @@index([codStatus])
  @@index([supplierId])
  @@index([area])
  @@index([financialStatus])
}

/// طلب فرعي لكل مورد داخل طلب العميل — المورد يتابع حالته
model VendorOrder {
  id              String        @id @default(cuid())
  number          Int           @unique @default(autoincrement())
  orderId         String
  vendorId        String
  status          RequestStatus @default(NEW)
  subtotal        Decimal       @db.Decimal(10, 3)
  total           Decimal       @db.Decimal(10, 3)
  commissionTotal Decimal       @db.Decimal(10, 3)
  vendorNet       Decimal       @db.Decimal(10, 3)
  /// التسوية التي دُفع فيها صافي المورد
  payoutId        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor Vendor        @relation(fields: [vendorId], references: [id])
  payout VendorPayout? @relation(fields: [payoutId], references: [id])
  items  OrderItem[]

  @@unique([orderId, vendorId])
  @@index([vendorId, status])
  @@index([payoutId])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  vendorOrderId     String
  vendorId          String
  /// فارغ لبنود طلبات التوصيل التي يكتبها المورد (بدون منتج من المتجر)
  productId         String?
  /// نسخة من اسم المنتج وقت الطلب
  name              String
  unitPrice         Decimal @db.Decimal(10, 3)
  discountPercent   Int     @default(0)
  unitFinalPrice    Decimal @db.Decimal(10, 3)
  quantity          Int
  lineTotal         Decimal @db.Decimal(10, 3)
  /// نسبة العمولة وقت البيع والمبالغ المحسوبة منها — تُحفظ ولا يُعاد حسابها
  commissionPercent Decimal @db.Decimal(5, 2)
  commissionAmount  Decimal @db.Decimal(10, 3)
  vendorNet         Decimal @db.Decimal(10, 3)

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  vendor      Vendor      @relation(fields: [vendorId], references: [id])
  product     Product?    @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([vendorOrderId])
  @@index([vendorId])
}

/// تسوية: دفع المستحق للمورد عن طلبات فرعية مكتملة
model VendorPayout {
  id              String        @id @default(cuid())
  vendorId        String
  /// صافي المورد المدفوع
  amount          Decimal       @db.Decimal(12, 3)
  salesTotal      Decimal       @db.Decimal(12, 3)
  commissionTotal Decimal       @db.Decimal(12, 3)
  ordersCount     Int
  method          PaymentMethod @default(BANK_TRANSFER)
  reference       String?
  note            String?
  recordedById    String?
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  vendor       Vendor        @relation(fields: [vendorId], references: [id])
  recordedBy   User?         @relation("PayoutRecordedBy", fields: [recordedById], references: [id])
  vendorOrders VendorOrder[]

  @@index([vendorId])
  @@index([paidAt])
}

// ─────────────────────────── الحجوزات ───────────────────────────

model Booking {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  ref           String        @unique
  type          BookingType
  status        RequestStatus @default(NEW)
  customerId    String
  // الحقول المشتركة (أعمدة مفهرسة)
  name          String
  phone         String
  locationText  String
  lat           Float?
  lng           Float?
  floor         String?
  scheduledAt   DateTime
  notes         String?
  urgency       Urgency       @default(NORMAL)
  zone          AreaZone?
  /// رسوم الكشف المحسوبة وقت الحجز (لحجوزات الكشف)
  inspectionFee Decimal?      @db.Decimal(10, 3)
  /// المبلغ الذي يسعّره الأدمن للعمل
  quotedAmount  Decimal?      @db.Decimal(10, 3)
  /// الحقول الخاصة بكل نوع
  details       Json          @default("{}")
  technicianId  String?
  adminNotes    String?
  whatsappText  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  customer   Customer       @relation(fields: [customerId], references: [id])
  technician Technician?    @relation(fields: [technicianId], references: [id])
  media      BookingMedia[]
  quoteFiles QuoteFile[]
  payments   Payment[]

  @@index([phone])
  @@index([status])
  @@index([scheduledAt])
  @@index([type])
  @@index([customerId])
  @@index([createdAt])
}

model BookingMedia {
  id           String    @id @default(cuid())
  bookingId    String
  kind         MediaKind @default(IMAGE)
  /// photo | design
  purpose      String    @default("photo")
  url          String
  publicId     String?
  originalName String?
  createdAt    DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ─────────────────────────── الشركات ───────────────────────────

/// كتالوج خدمات الشركات (سنوي / عاجل)
model CorporateService {
  id        String               @id @default(cuid())
  key       String               @unique
  name      String
  kind      CorporateRequestType
  sortOrder Int                  @default(0)
  active    Boolean              @default(true)

  requests  CorporateRequest[]
  contracts Contract[]         @relation("ContractServices")
  tenders   Tender[]
}

model CorporateRequest {
  id                     String               @id @default(cuid())
  number                 Int                  @unique @default(autoincrement())
  ref                    String               @unique
  type                   CorporateRequestType
  status                 RequestStatus        @default(NEW)
  customerId             String
  companyName            String
  contactName            String
  managerPhone           String
  maintenancePhone       String
  locationText           String
  lat                    Float?
  lng                    Float?
  commercialRegisterUrl  String?
  licenseUrl             String?
  // خاصة بالطلب العاجل
  workLocation           String?
  productionImpact       ProductionImpact?
  productionLineAffected Boolean?
  urgencyLevel           UrgencyLevel?
  notes                  String?
  adminNotes             String?
  quotedAmount           Decimal?             @db.Decimal(10, 3)
  /// العقد الذي يُنفَّذ هذا الطلب ضمنه (طلبات الصيانة ضمن عقد)
  contractId             String?
  whatsappText           String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?

  customer   Customer           @relation(fields: [customerId], references: [id])
  services   CorporateService[]
  contracts  Contract[]
  contract   Contract?          @relation("ContractRequests", fields: [contractId], references: [id])
  quoteFiles QuoteFile[]

  @@index([status])
  @@index([managerPhone])
  @@index([createdAt])
  @@index([customerId])
}

model Contract {
  id                 String         @id @default(cuid())
  number             Int            @unique @default(autoincrement())
  corporateRequestId String?
  customerId         String
  title              String
  startDate          DateTime
  endDate            DateTime
  value              Decimal        @db.Decimal(12, 3)
  status             ContractStatus @default(ACTIVE)
  fileUrl            String?
  reminderDays       Int            @default(30)
  reminderSentAt     DateTime?
  notes              String?
  /// مرجع متسلسل مثل MC-2026-00001 (العقود القديمة تبقى برقمها)
  ref                String?        @unique
  type               ContractType   @default(MAINTENANCE)
  paymentMethod      PaymentMethod?
  /// عدد الزيارات المشمولة
  visitsIncluded     Int?
  /// زمن الاستجابة المتفق عليه (بالساعات)
  responseHours      Int?
  technicianId       String?
  terms              String?
  renewalStatus      RenewalStatus  @default(NONE)
  tenderId           String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  corporateRequest CorporateRequest?  @relation(fields: [corporateRequestId], references: [id])
  customer         Customer           @relation(fields: [customerId], references: [id])
  technician       Technician?        @relation(fields: [technicianId], references: [id])
  tender           Tender?            @relation(fields: [tenderId], references: [id])
  services         CorporateService[] @relation("ContractServices")
  visits           ContractVisit[]
  requests         CorporateRequest[] @relation("ContractRequests")
  payments         Payment[]
  quoteFiles       QuoteFile[]

  @@index([endDate])
  @@index([status])
  @@index([customerId])
  @@index([type])
}

/// زيارة خدمة ضمن عقد
model ContractVisit {
  id           String              @id @default(cuid())
  contractId   String
  scheduledAt  DateTime
  technicianId String?
  status       ContractVisitStatus @default(SCHEDULED)
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  contract   Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  technician Technician? @relation(fields: [technicianId], references: [id])

  @@index([contractId])
  @@index([scheduledAt])
}

// ─────────────────────────── العطاءات ───────────────────────────

/// عطاء تنشره شركة (عميل) لخدمة صيانة
model Tender {
  id                String       @id @default(cuid())
  /// TEN-2026-00001
  ref               String       @unique
  customerId        String
  title             String
  description       String
  serviceId         String?
  location          String
  durationMonths    Int?
  deadline          DateTime
  budget            Decimal?     @db.Decimal(12, 3)
  requirements      String?
  attachments       Json         @default("[]")
  status            TenderStatus @default(DRAFT)
  // ── الترسية والعمولة (تُحفظ وقت الترسية) ──
  awardedOfferId    String?      @unique
  awardedAmount     Decimal?     @db.Decimal(12, 3)
  commissionPercent Decimal?     @db.Decimal(5, 2)
  commissionAmount  Decimal?     @db.Decimal(12, 3)
  providerAmount    Decimal?     @db.Decimal(12, 3)
  awardedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  customer     Customer          @relation(fields: [customerId], references: [id])
  service      CorporateService? @relation(fields: [serviceId], references: [id])
  offers       TenderOffer[]     @relation("TenderOffers")
  awardedOffer TenderOffer?      @relation("AwardedOffer", fields: [awardedOfferId], references: [id])
  contract     Contract?

  @@index([status])
  @@index([deadline])
  @@index([customerId])
}

/// عرض على عطاء: من المنصة نفسها (vendorId فارغ) أو من مورد/شركة
model TenderOffer {
  id           String            @id @default(cuid())
  tenderId     String
  vendorId     String?
  providerName String
  price        Decimal           @db.Decimal(12, 3)
  proposal     String
  attachments  Json              @default("[]")
  status       TenderOfferStatus @default(SUBMITTED)
  submittedAt  DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tender    Tender  @relation("TenderOffers", fields: [tenderId], references: [id], onDelete: Cascade)
  vendor    Vendor? @relation(fields: [vendorId], references: [id])
  awardedOf Tender? @relation("AwardedOffer")

  @@index([tenderId])
  @@index([vendorId])
}

// ─────────────────────────── التوصيل ───────────────────────────

model DeliveryCompany {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  /// رسوم التوصيل الافتراضية لكل طلب
  defaultFee  Decimal  @default(0) @db.Decimal(10, 3)
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
  settlements DeliverySettlement[]
}

/// سائق التوصيل الداخلي
model Driver {
  id        String       @id @default(cuid())
  name      String
  phone     String
  status    DriverStatus @default(ACTIVE)
  notes     String?
  /// حساب الدخول (موظف توصيل) — فارغ للسائقين المسجّلين بدون حساب
  userId    String?      @unique
  /// مناطق العمل (للتوزيع التلقائي لاحقًا)، مفصولة بفواصل
  areas     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user        User?                @relation(fields: [userId], references: [id])
  orders      Order[]
  settlements DeliverySettlement[]
  assignments DeliveryAssignment[]
}

/// تسليم النقد المحصّل (من سائق أو شركة توصيل) للشركة — لا يُحذف، يُلغى فقط
model DeliverySettlement {
  id                String           @id @default(cuid())
  /// SET-2026-00001
  ref               String           @unique
  driverId          String?
  deliveryCompanyId String?
  amount            Decimal          @db.Decimal(12, 3)
  ordersCount       Int
  status            SettlementStatus @default(CONFIRMED)
  notes             String?
  receivedById      String?
  receivedAt        DateTime         @default(now())
  voidedAt          DateTime?
  voidReason        String?
  createdAt         DateTime         @default(now())

  driver          Driver?          @relation(fields: [driverId], references: [id])
  deliveryCompany DeliveryCompany? @relation(fields: [deliveryCompanyId], references: [id])
  receivedBy      User?            @relation("SettlementReceivedBy", fields: [receivedById], references: [id])
  orders          Order[]

  @@index([driverId])
  @@index([deliveryCompanyId])
  @@index([receivedAt])
}

/// عدّاد المراجع المتسلسلة لكل بادئة وسنة (MC-2026، TEN-2026، SET-2026)
model RefCounter {
  key   String @id
  value Int    @default(0)
}

// ─────────────────────────── الملفات والمالية ───────────────────────────

/// ملفات التقييم وعروض الأسعار والعقود التي يرفعها الأدمن للعميل
model QuoteFile {
  id                 String        @id @default(cuid())
  customerId         String
  bookingId          String?
  orderId            String?
  corporateRequestId String?
  contractId         String?
  kind               QuoteFileKind @default(QUOTE)
  title              String
  url                String
  publicId           String?
  amount             Decimal?      @db.Decimal(12, 3)
  uploadedById       String?
  createdAt          DateTime      @default(now())
  deletedAt          DateTime?

  customer         Customer          @relation(fields: [customerId], references: [id])
  booking          Booking?          @relation(fields: [bookingId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  corporateRequest CorporateRequest? @relation(fields: [corporateRequestId], references: [id])
  contract         Contract?         @relation(fields: [contractId], references: [id])
  uploadedBy       User?             @relation("QuoteUploadedBy", fields: [uploadedById], references: [id])

  @@index([customerId])
  @@index([createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  customerId   String
  bookingId    String?
  orderId      String?
  contractId   String?
  amount       Decimal       @db.Decimal(12, 3)
  method       PaymentMethod @default(CASH)
  paidAt       DateTime      @default(now())
  reference    String?
  note         String?
  recordedById String?
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  customer   Customer  @relation(fields: [customerId], references: [id])
  booking    Booking?  @relation(fields: [bookingId], references: [id])
  order      Order?    @relation(fields: [orderId], references: [id])
  contract   Contract? @relation(fields: [contractId], references: [id])
  recordedBy User?     @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([customerId])
  @@index([paidAt])
}

// ─────────────────────────── النظام ───────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model WhatsAppLog {
  id         String          @id @default(cuid())
  to         String
  channel    WhatsAppChannel
  status     WhatsAppStatus
  message    String
  link       String?
  error      String?
  entityType String?
  entityId   String?
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  /// admin | customer | system | public
  actorType String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

/// نشرة بريدية موحّدة لكل العملاء المسجّلين (منتج جديد، خدمة جديدة، إعلان)
model EmailCampaign {
  id          String    @id @default(cuid())
  subject     String
  body        String
  /// زر في الرسالة: none | product | bookings | corporate | store
  ctaKind     String    @default("none")
  productId   String?
  /// SENDING | DONE | FAILED
  status      String    @default("SENDING")
  recipients  Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  lastError   String?
  createdById String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([createdAt])
}

/// قفل تسجيل الدخول بعد محاولات خاطئة متكررة (لكل هاتف/بريد، حتى لو لم يكن الحساب موجودًا)
model LoginLock {
  /// المعرّف الموحّد: بريد بأحرف صغيرة أو رقم هاتف بالصيغة الدولية
  key         String    @id
  /// المحاولات الخاطئة منذ آخر قفل/نجاح
  failures    Int       @default(0)
  /// عدد مرات القفل المتتالية (كل مرة تتضاعف المدة)
  level       Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// إسناد الطلب لموظف توصيل (سجل كامل لكل إسناد وإعادة إسناد)
model DeliveryAssignment {
  id           String           @id @default(cuid())
  orderId      String
  driverId     String
  assignedById String?
  status       AssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime         @default(now())
  acceptedAt   DateTime?
  endedAt      DateTime?
  note         String?

  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver     Driver @relation(fields: [driverId], references: [id])
  assignedBy User?  @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([orderId])
  @@index([driverId, status])
}

/// سجل تغيّر حالة الطلب (Activity Log)
model OrderStatusEvent {
  id         String          @id @default(cuid())
  orderId    String
  fromStatus DeliveryStatus?
  toStatus   DeliveryStatus
  /// المستخدم (إدارة/توصيل)، أو فارغ للعميل/المورد/النظام
  actorId    String?
  /// user | vendor | customer | system
  actorType  String
  actorName  String?
  note       String?
  lat        Float?
  lng        Float?
  createdAt  DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
  @@index([actorId])
  @@index([createdAt])
}

/// إثبات التسليم — لا يُعدَّل إلا بصلاحية proofs.edit
model DeliveryProof {
  id              String    @id @default(cuid())
  orderId         String    @unique
  deliveredAt     DateTime  @default(now())
  lat             Float?
  lng             Float?
  accuracy        Float?
  recipientName   String
  signatureUrl    String?
  photoUrl        String?
  otpVerified     Boolean   @default(false)
  amountCollected Decimal?  @db.Decimal(10, 3)
  note            String?
  createdById     String?
  editedAt        DateTime?
  createdAt       DateTime  @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ProofBy", fields: [createdById], references: [id])
}

/// الإشعارات داخل النظام (قابلة لإضافة قنوات: واتساب، SMS، بريد)
model Notification {
  id            String                @id @default(cuid())
  recipientType NotificationRecipient
  /// userId أو customerId أو vendorId حسب النوع
  recipientId   String
  userId        String?
  title         String
  body          String
  orderId       String?
  /// in_app | whatsapp | sms | email
  channel       String                @default("in_app")
  readAt        DateTime?
  createdAt     DateTime              @default(now())

  user  User?  @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([recipientType, recipientId, readAt])
  @@index([createdAt])
}

/// الغرض من رمز التحقق المرسل بالبريد
enum OtpPurpose {
  LOGIN_2FA
  VERIFY_EMAIL
  PASSWORD_RESET
  SENSITIVE_ACTION
}

/// رموز التحقق بالبريد (OTP): يُخزن هاش الرمز فقط، صالح لمدة قصيرة ولمرة واحدة
model EmailOtp {
  id          String     @id @default(cuid())
  purpose     OtpPurpose
  /// customer | user
  subjectType String
  subjectId   String
  email       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime   @default(now())

  @@index([subjectType, subjectId, purpose, createdAt])
  @@index([expiresAt])
}
