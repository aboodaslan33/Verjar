// مجموعة فرجا (Farja Group) — مخطط قاعدة البيانات
// PostgreSQL + Prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── التعدادات ───────────────────────────

enum UserRole {
  ADMIN
  STAFF
}

/// حالة موحّدة للحجوزات والطلبات وطلبات الشركات
enum RequestStatus {
  NEW // جديد
  UNDER_REVIEW // قيد المراجعة
  PRICED // تم التسعير
  CONFIRMED // مؤكد
  IN_PROGRESS // قيد التنفيذ
  COMPLETED // مكتمل
  CANCELLED // ملغي
}

enum BookingType {
  INSPECTION // أعطال بناء / كشف عن الموقع
  PAINTING // أعمال دهان
  CONSTRUCTION // أعمال البناء
  METALWORK // أعمال معدنية
  GENERAL // خدمات عامة
}

enum Urgency {
  NORMAL // عادي
  URGENT // عاجل
  EMERGENCY // طارئ
}

enum AreaZone {
  INSIDE_AMMAN
  OUTSIDE_AMMAN
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum CorporateRequestType {
  ANNUAL // عقد صيانة سنوي
  URGENT // طلب صيانة عاجل
}

enum ProductionImpact {
  NO_STOP_NEEDED // يمكن العمل دون إيقاف الإنتاج
  CANNOT_STOP // لا يمكن إيقاف الإنتاج
  PARTIAL_STOP // يمكن الإيقاف جزئيًا
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum QuoteFileKind {
  EVALUATION // تقييم
  QUOTE // عرض سعر
  CONTRACT // عقد
  INVOICE // فاتورة
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CLIQ
  CARD
  OTHER
}

/// مراجعة منتجات الموردين قبل ظهورها في المتجر
enum ProductApproval {
  PENDING // بانتظار المراجعة
  APPROVED // معتمد
  REJECTED // مرفوض
}

enum WhatsAppChannel {
  LINK // رابط wa.me يفتحه المستخدم
  CLOUD_API // إرسال تلقائي عبر Meta Cloud API
}

enum WhatsAppStatus {
  PREPARED
  SENT
  FAILED
}

// ─────────────────────────── المستخدمون ───────────────────────────

/// حسابات لوحة التحكم (الأدمن والموظفون)
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(ADMIN)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]
  campaigns EmailCampaign[]
  payments  Payment[]       @relation("PaymentRecordedBy")
  payouts   VendorPayout[]  @relation("PayoutRecordedBy")
  quotes    QuoteFile[]     @relation("QuoteUploadedBy")
}

/// العملاء — يتم إنشاؤهم تلقائيًا عند أول حجز أو طلب برقم الهاتف، أو بالتسجيل من صفحة /register
model Customer {
  id           String    @id @default(cuid())
  phone        String    @unique
  name         String
  /// يُخزن بأحرف صغيرة — يُستخدم للدخول مع كلمة المرور
  email        String?   @unique
  companyName  String?
  passwordHash String?
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  notes        String?
  lastLoginAt  DateTime?
  /// وقت إنشاء الحساب بالتسجيل الذاتي (فارغ للعملاء المنشئين تلقائيًا من الحجز)
  registeredAt DateTime?
  /// موافقة على استلام النشرة البريدية (منتجات وخدمات جديدة) — يمكن إلغاؤها من الحساب أو رابط البريد
  emailOptIn   Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  bookings          Booking[]
  orders            Order[]
  vendor            Vendor?
  corporateRequests CorporateRequest[]
  contracts         Contract[]
  quoteFiles        QuoteFile[]
  payments          Payment[]

  @@index([name])
  @@index([deletedAt])
}

/// الفنيون الذين يُعيَّنون على الحجوزات
model Technician {
  id        String    @id @default(cuid())
  name      String
  phone     String
  specialty String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

// ─────────────────────────── المتجر ───────────────────────────

/// أقسام السوق (ديناميكية من لوحة التحكم) — مستويان: قسم رئيسي وأقسام فرعية
model Category {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  /// القسم الرئيسي (فارغ للأقسام الرئيسية)
  parentId   String?
  /// حقول المواصفات لمنتجات هذا القسم: [{ key, label, type: text|number|select, options?, required? }]
  specFields Json      @default("[]")
  sortOrder  Int       @default(0)
  visible    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

/// المورد (متجر داخل السوق). المورد الافتراضي (isHouse) هو الشركة نفسها وليس له حساب عميل
model Vendor {
  id                String   @id @default(cuid())
  /// حساب العميل صاحب المتجر (فارغ للمورد الافتراضي)
  customerId        String?  @unique
  name              String
  slug              String   @unique
  description       String   @default("")
  logoUrl           String?
  logoPublicId      String?
  /// نسبة عمولة المنصة من كل بيع (0–100)
  commissionPercent Decimal  @default(10) @db.Decimal(5, 2)
  /// سحب صلاحية المورد: لا يدخل اللوحة ولا تظهر منتجاته
  active            Boolean  @default(true)
  isHouse           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer     Customer?      @relation(fields: [customerId], references: [id])
  products     Product[]
  vendorOrders VendorOrder[]
  orderItems   OrderItem[]
  payouts      VendorPayout[]

  @@index([active])
}

model Product {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String
  /// السعر الأصلي بالدينار (3 خانات عشرية = فلس)
  price           Decimal         @db.Decimal(10, 3)
  /// نسبة الخصم 0–90
  discountPercent Int             @default(0)
  /// السعر النهائي بعد الخصم — يُحسب تلقائيًا عند الحفظ
  finalPrice      Decimal         @db.Decimal(10, 3)
  stock           Int             @default(0)
  visible         Boolean         @default(true)
  featured        Boolean         @default(false)
  categoryId      String
  vendorId        String
  /// منتجات الموردين تظهر بعد موافقة الإدارة
  approvalStatus  ProductApproval @default(PENDING)
  rejectionReason String?
  /// المواصفات حسب حقول القسم، مثل { "size": "L", "color": "أسود" }
  specs           Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  category   Category       @relation(fields: [categoryId], references: [id])
  vendor     Vendor         @relation(fields: [vendorId], references: [id])
  media      ProductMedia[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([vendorId])
  @@index([approvalStatus])
  @@index([visible, deletedAt])
  @@index([featured])
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  kind      MediaKind @default(IMAGE)
  url       String
  publicId  String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id            String        @id @default(cuid())
  /// رقم الطلب المعروض (#1042)
  number        Int           @unique @default(autoincrement())
  /// رمز مرجعي عشوائي يستخدمه العميل للدخول لحسابه
  ref           String        @unique
  customerId    String
  customerName  String
  phone         String
  address       String
  notes         String?
  status        RequestStatus @default(NEW)
  subtotal      Decimal       @db.Decimal(10, 3)
  discountTotal Decimal       @db.Decimal(10, 3)
  total         Decimal       @db.Decimal(10, 3)
  whatsappText  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  customer     Customer      @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  vendorOrders VendorOrder[]
  payments     Payment[]
  quoteFiles   QuoteFile[]

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

/// طلب فرعي لكل مورد داخل طلب العميل — المورد يتابع حالته
model VendorOrder {
  id              String        @id @default(cuid())
  number          Int           @unique @default(autoincrement())
  orderId         String
  vendorId        String
  status          RequestStatus @default(NEW)
  subtotal        Decimal       @db.Decimal(10, 3)
  total           Decimal       @db.Decimal(10, 3)
  commissionTotal Decimal       @db.Decimal(10, 3)
  vendorNet       Decimal       @db.Decimal(10, 3)
  /// التسوية التي دُفع فيها صافي المورد
  payoutId        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor Vendor        @relation(fields: [vendorId], references: [id])
  payout VendorPayout? @relation(fields: [payoutId], references: [id])
  items  OrderItem[]

  @@unique([orderId, vendorId])
  @@index([vendorId, status])
  @@index([payoutId])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  vendorOrderId     String
  vendorId          String
  productId         String
  /// نسخة من اسم المنتج وقت الطلب
  name              String
  unitPrice         Decimal @db.Decimal(10, 3)
  discountPercent   Int     @default(0)
  unitFinalPrice    Decimal @db.Decimal(10, 3)
  quantity          Int
  lineTotal         Decimal @db.Decimal(10, 3)
  /// نسبة العمولة وقت البيع والمبالغ المحسوبة منها — تُحفظ ولا يُعاد حسابها
  commissionPercent Decimal @db.Decimal(5, 2)
  commissionAmount  Decimal @db.Decimal(10, 3)
  vendorNet         Decimal @db.Decimal(10, 3)

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  vendor      Vendor      @relation(fields: [vendorId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([vendorOrderId])
  @@index([vendorId])
}

/// تسوية: دفع المستحق للمورد عن طلبات فرعية مكتملة
model VendorPayout {
  id              String        @id @default(cuid())
  vendorId        String
  /// صافي المورد المدفوع
  amount          Decimal       @db.Decimal(12, 3)
  salesTotal      Decimal       @db.Decimal(12, 3)
  commissionTotal Decimal       @db.Decimal(12, 3)
  ordersCount     Int
  method          PaymentMethod @default(BANK_TRANSFER)
  reference       String?
  note            String?
  recordedById    String?
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  vendor       Vendor        @relation(fields: [vendorId], references: [id])
  recordedBy   User?         @relation("PayoutRecordedBy", fields: [recordedById], references: [id])
  vendorOrders VendorOrder[]

  @@index([vendorId])
  @@index([paidAt])
}

// ─────────────────────────── الحجوزات ───────────────────────────

model Booking {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  ref           String        @unique
  type          BookingType
  status        RequestStatus @default(NEW)
  customerId    String
  // الحقول المشتركة (أعمدة مفهرسة)
  name          String
  phone         String
  locationText  String
  lat           Float?
  lng           Float?
  floor         String?
  scheduledAt   DateTime
  notes         String?
  urgency       Urgency       @default(NORMAL)
  zone          AreaZone?
  /// رسوم الكشف المحسوبة وقت الحجز (لحجوزات الكشف)
  inspectionFee Decimal?      @db.Decimal(10, 3)
  /// المبلغ الذي يسعّره الأدمن للعمل
  quotedAmount  Decimal?      @db.Decimal(10, 3)
  /// الحقول الخاصة بكل نوع
  details       Json          @default("{}")
  technicianId  String?
  adminNotes    String?
  whatsappText  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  customer   Customer       @relation(fields: [customerId], references: [id])
  technician Technician?    @relation(fields: [technicianId], references: [id])
  media      BookingMedia[]
  quoteFiles QuoteFile[]
  payments   Payment[]

  @@index([phone])
  @@index([status])
  @@index([scheduledAt])
  @@index([type])
  @@index([customerId])
  @@index([createdAt])
}

model BookingMedia {
  id           String    @id @default(cuid())
  bookingId    String
  kind         MediaKind @default(IMAGE)
  /// photo | design
  purpose      String    @default("photo")
  url          String
  publicId     String?
  originalName String?
  createdAt    DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ─────────────────────────── الشركات ───────────────────────────

/// كتالوج خدمات الشركات (سنوي / عاجل)
model CorporateService {
  id        String               @id @default(cuid())
  key       String               @unique
  name      String
  kind      CorporateRequestType
  sortOrder Int                  @default(0)
  active    Boolean              @default(true)

  requests CorporateRequest[]
}

model CorporateRequest {
  id                     String               @id @default(cuid())
  number                 Int                  @unique @default(autoincrement())
  ref                    String               @unique
  type                   CorporateRequestType
  status                 RequestStatus        @default(NEW)
  customerId             String
  companyName            String
  contactName            String
  managerPhone           String
  maintenancePhone       String
  locationText           String
  lat                    Float?
  lng                    Float?
  commercialRegisterUrl  String?
  licenseUrl             String?
  // خاصة بالطلب العاجل
  workLocation           String?
  productionImpact       ProductionImpact?
  productionLineAffected Boolean?
  urgencyLevel           UrgencyLevel?
  notes                  String?
  adminNotes             String?
  quotedAmount           Decimal?             @db.Decimal(10, 3)
  whatsappText           String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?

  customer   Customer           @relation(fields: [customerId], references: [id])
  services   CorporateService[]
  contracts  Contract[]
  quoteFiles QuoteFile[]

  @@index([status])
  @@index([managerPhone])
  @@index([createdAt])
  @@index([customerId])
}

model Contract {
  id                 String         @id @default(cuid())
  number             Int            @unique @default(autoincrement())
  corporateRequestId String?
  customerId         String
  title              String
  startDate          DateTime
  endDate            DateTime
  value              Decimal        @db.Decimal(12, 3)
  status             ContractStatus @default(ACTIVE)
  fileUrl            String?
  reminderDays       Int            @default(30)
  reminderSentAt     DateTime?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  corporateRequest CorporateRequest? @relation(fields: [corporateRequestId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  payments         Payment[]
  quoteFiles       QuoteFile[]

  @@index([endDate])
  @@index([status])
  @@index([customerId])
}

// ─────────────────────────── الملفات والمالية ───────────────────────────

/// ملفات التقييم وعروض الأسعار والعقود التي يرفعها الأدمن للعميل
model QuoteFile {
  id                 String        @id @default(cuid())
  customerId         String
  bookingId          String?
  orderId            String?
  corporateRequestId String?
  contractId         String?
  kind               QuoteFileKind @default(QUOTE)
  title              String
  url                String
  publicId           String?
  amount             Decimal?      @db.Decimal(12, 3)
  uploadedById       String?
  createdAt          DateTime      @default(now())
  deletedAt          DateTime?

  customer         Customer          @relation(fields: [customerId], references: [id])
  booking          Booking?          @relation(fields: [bookingId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  corporateRequest CorporateRequest? @relation(fields: [corporateRequestId], references: [id])
  contract         Contract?         @relation(fields: [contractId], references: [id])
  uploadedBy       User?             @relation("QuoteUploadedBy", fields: [uploadedById], references: [id])

  @@index([customerId])
  @@index([createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  customerId   String
  bookingId    String?
  orderId      String?
  contractId   String?
  amount       Decimal       @db.Decimal(12, 3)
  method       PaymentMethod @default(CASH)
  paidAt       DateTime      @default(now())
  reference    String?
  note         String?
  recordedById String?
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  customer   Customer  @relation(fields: [customerId], references: [id])
  booking    Booking?  @relation(fields: [bookingId], references: [id])
  order      Order?    @relation(fields: [orderId], references: [id])
  contract   Contract? @relation(fields: [contractId], references: [id])
  recordedBy User?     @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([customerId])
  @@index([paidAt])
}

// ─────────────────────────── النظام ───────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model WhatsAppLog {
  id         String          @id @default(cuid())
  to         String
  channel    WhatsAppChannel
  status     WhatsAppStatus
  message    String
  link       String?
  error      String?
  entityType String?
  entityId   String?
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  /// admin | customer | system | public
  actorType String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

/// نشرة بريدية موحّدة لكل العملاء المسجّلين (منتج جديد، خدمة جديدة، إعلان)
model EmailCampaign {
  id          String    @id @default(cuid())
  subject     String
  body        String
  /// زر في الرسالة: none | product | bookings | corporate | store
  ctaKind     String    @default("none")
  productId   String?
  /// SENDING | DONE | FAILED
  status      String    @default("SENDING")
  recipients  Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  lastError   String?
  createdById String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([createdAt])
}

/// قفل تسجيل الدخول بعد محاولات خاطئة متكررة (لكل هاتف/بريد، حتى لو لم يكن الحساب موجودًا)
model LoginLock {
  /// المعرّف الموحّد: بريد بأحرف صغيرة أو رقم هاتف بالصيغة الدولية
  key         String    @id
  /// المحاولات الخاطئة منذ آخر قفل/نجاح
  failures    Int       @default(0)
  /// عدد مرات القفل المتتالية (كل مرة تتضاعف المدة)
  level       Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}
