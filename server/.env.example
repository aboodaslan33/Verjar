# ───── أساسي ─────
NODE_ENV=development
PORT=4000
# رابط قاعدة البيانات (Render يعطيك Internal Database URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verjar
# سر توقيع JWT — استخدم نصًا عشوائيًا طويلًا (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
# رابط الواجهة (للـ CORS). يمكن وضع أكثر من رابط مفصولة بفاصلة
CLIENT_URL=http://localhost:5173
# رابط الـ API العام (يُستخدم لبناء روابط الملفات المحلية في وضع التطوير)
PUBLIC_API_URL=http://localhost:4000
# lax عندما تكون الواجهة والـ API على نفس الدومين (عبر rewrite)، none عندما يكونان على دومينين مختلفين
COOKIE_SAMESITE=lax
# عدد البروكسيات أمام السيرفر (Render = 1). يُستخدم لمعرفة IP العميل الحقيقي في حدود محاولات الدخول
TRUST_PROXY=1

# ───── الأدمن الأولي (يستخدمه seed) ─────
ADMIN_EMAIL=farjarweb@gmail.com
# كلمة مرور قوية خاصة بك (8 أحرف على الأقل) — لا تستخدم مثالًا منشورًا
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=إدارة مجموعة فرجا

# ───── واتساب ─────
# رقم واتساب الإدارة بالصيغة الدولية بدون + (الأردن 962)
ADMIN_WHATSAPP=962780192930
# اختياري: WhatsApp Cloud API من Meta — إذا تُركت فارغة يعمل الموقع بروابط wa.me
# link (افتراضي): الموقع يفتح واتساب برسالة جاهزة. cloud: إرسال تلقائي (يتطلب WA_TOKEN و WA_PHONE_ID صالحين)
WA_MODE=link
WA_TOKEN=
WA_PHONE_ID=
WA_API_VERSION=v21.0

# ───── رفع الملفات ─────
# cloudinary://<api_key>:<api_secret>@<cloud_name>
# إذا تُرك فارغًا في التطوير تُحفظ الملفات في server/uploads (لا تعتمد عليه على Render)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=verjar
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verjar_test

# ───── البريد (النشرة البريدية واستعادة كلمة المرور) ─────
# Gmail: فعّل التحقق بخطوتين ثم أنشئ App Password من myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=مجموعة فرجا
