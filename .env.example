# هذا الملف للتوضيح فقط. الملفات الفعلية:
#   server/.env   (انسخ server/.env.example)
#   client/.env   (انسخ client/.env.example — اختياري)

# ───── server/.env ─────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verjar
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
COOKIE_SAMESITE=lax
# عدد البروكسيات أمام السيرفر (Render = 1). يُستخدم لمعرفة IP العميل الحقيقي في حدود محاولات الدخول
TRUST_PROXY=1
ADMIN_EMAIL=farjarweb@gmail.com
# كلمة مرور قوية خاصة بك (8 أحرف على الأقل) — لا تستخدم مثالًا منشورًا
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=إدارة فرجار قروب
ADMIN_WHATSAPP=962780192930
# link (افتراضي): الموقع يفتح واتساب برسالة جاهزة. cloud: إرسال تلقائي (يتطلب WA_TOKEN و WA_PHONE_ID صالحين)
WA_MODE=link
WA_TOKEN=
WA_PHONE_ID=
WA_API_VERSION=v21.0
CLOUDINARY_URL=
CLOUDINARY_FOLDER=verjar
# قاعدة بيانات الاختبارات (يجب أن يحتوي اسمها على test)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verjar_test

# ───── client/.env ─────
# فارغ = استخدام /api على نفس الدومين (proxy في التطوير، rewrite على Render)
VITE_API_URL=

# ───── البريد (النشرة البريدية واستعادة كلمة المرور) ─────
# Gmail: فعّل التحقق بخطوتين ثم أنشئ App Password من myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=فرجار قروب
